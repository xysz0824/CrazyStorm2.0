<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="TitleBarBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="0" />
        <GradientStop Color="#FFF0F0F0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GroupBorderBrush" Color="#C9C9C9" />
    <SolidColorBrush x:Key="IconBrush" Color="White" />
    <SolidColorBrush x:Key="TextBrush" Color="Black" />
    <LinearGradientBrush x:Key="HeadToolBarBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF0F0F0" Offset="0" />
        <GradientStop Color="#FFB4B4B4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToolBarBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="0" />
        <GradientStop Color="#FFF0F0F0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TabDisableBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFD1D1D1" Offset="0" />
        <GradientStop Color="#FFD1D1D1" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TabUnselectBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF5F5F5" Offset="0" />
        <GradientStop Color="#FFE3E3E3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TabSelectBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="0" />
        <GradientStop Color="White" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScreenBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFD4D4D4" Offset="0" />
        <GradientStop Color="White" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ListBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="0" />
        <GradientStop Color="White" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#EDEDED" />
    <Color x:Key="ScrollBarCornerColor">#EDEDED</Color>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#BFBFBF" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#808080" />
    <ImageBrush x:Key="SelectedGroupImageBrush" ImageSource="../Images/selectedgroup.png"/>
    <ImageSource x:Key="RulerImage">../Images/ruler.png</ImageSource>
</ResourceDictionary>